{
  "name": "indonesian-badwords",
  "version": "2.6.0",
  "description": "Indonesian profanity filter with severity, category and region classification, leetspeak, evasion and fuzzy matching, scoped exceptions, censor strategies and exact offsets. Zero dependencies, TypeScript.",
  "keywords": [
    "indonesian",
    "bahasa-indonesia",
    "indonesia",
    "profanity",
    "profanity-filter",
    "badwords",
    "kata-kotor",
    "kata-kasar",
    "sensor",
    "censor",
    "moderation",
    "text-moderation",
    "content-moderation",
    "chat-moderation",
    "severity",
    "category",
    "classification",
    "slang",
    "jawa",
    "sunda",
    "leetspeak",
    "fuzzy-matching",
    "unicode",
    "typescript"
  ],
  "homepage": "https://github.com/drizki/indonesian-badwords#readme",
  "bugs": {
    "url": "https://github.com/drizki/indonesian-badwords/issues"
  },
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json",
    "./censor": {
      "import": {
        "types": "./dist/esm/censor.d.ts",
        "default": "./dist/esm/censor.js"
      },
      "require": {
        "types": "./dist/cjs/censor.d.ts",
        "default": "./dist/cjs/censor.js"
      }
    },
    "./metadata": {
      "import": {
        "types": "./dist/esm/metadata.d.ts",
        "default": "./dist/esm/metadata.js"
      },
      "require": {
        "types": "./dist/cjs/metadata.d.ts",
        "default": "./dist/cjs/metadata.js"
      }
    },
    "./catalog": {
      "import": {
        "types": "./dist/esm/catalog.d.ts",
        "default": "./dist/esm/catalog.js"
      },
      "require": {
        "types": "./dist/cjs/catalog.d.ts",
        "default": "./dist/cjs/catalog.js"
      }
    },
    "./evasion": {
      "import": {
        "types": "./dist/esm/evasion.d.ts",
        "default": "./dist/esm/evasion.js"
      },
      "require": {
        "types": "./dist/cjs/evasion.d.ts",
        "default": "./dist/cjs/evasion.js"
      }
    },
    "./evaluate": {
      "import": {
        "types": "./dist/esm/evaluate.d.ts",
        "default": "./dist/esm/evaluate.js"
      },
      "require": {
        "types": "./dist/cjs/evaluate.d.ts",
        "default": "./dist/cjs/evaluate.js"
      }
    },
    "./fuzzy": {
      "import": {
        "types": "./dist/esm/fuzzy.d.ts",
        "default": "./dist/esm/fuzzy.js"
      },
      "require": {
        "types": "./dist/cjs/fuzzy.d.ts",
        "default": "./dist/cjs/fuzzy.js"
      }
    }
  },
  "files": [
    "README.id.md",
    "dist/cjs/index.js",
    "dist/cjs/index.d.ts",
    "dist/cjs/censor.js",
    "dist/cjs/censor.d.ts",
    "dist/cjs/metadata.js",
    "dist/cjs/metadata.d.ts",
    "dist/cjs/catalog.js",
    "dist/cjs/catalog.d.ts",
    "dist/cjs/dictionary/types.d.ts",
    "dist/cjs/dictionary/registry.d.ts",
    "dist/cjs/dictionary/presets.d.ts",
    "dist/cjs/text/normalize.d.ts",
    "dist/cjs/package.json",
    "dist/esm",
    "dist/cjs/evasion.js",
    "dist/cjs/evasion.d.ts",
    "dist/cjs/evasion/types.d.ts",
    "dist/cjs/core/matcher.d.ts",
    "dist/cjs/core/provenance.d.ts",
    "THIRD_PARTY_NOTICES",
    "dist/cjs/fuzzy.js",
    "dist/cjs/fuzzy.d.ts",
    "dist/cjs/fuzzy/types.d.ts",
    "dist/cjs/censor/strategies.d.ts",
    "dist/cjs/dictionary/metadata.d.ts",
    "dist/cjs/dictionary/catalog.d.ts",
    "dist/cjs/evasion/policy.d.ts",
    "dist/cjs/fuzzy/policy.d.ts",
    "dist/cjs/evaluate.js",
    "dist/cjs/evaluate.d.ts",
    "dist/cjs/evaluate/evaluate.d.ts"
  ],
  "sideEffects": false,
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && node scripts/catalog-data.mjs && tsc -p tsconfig.cjs.json && node scripts/postbuild.mjs",
    "catalog:generate": "node scripts/catalog-data.mjs --write",
    "test": "npm run build && npm run test:unit",
    "test:unit": "node --test",
    "test:coverage": "npm run build && node --test --experimental-test-coverage",
    "test:package": "node scripts/verify-package.mjs",
    "benchmark": "npm run build && node scripts/benchmark.mjs",
    "benchmark:compare": "npm run build && node scripts/benchmark-compare.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm test",
    "test:docs": "node scripts/verify-docs.mjs",
    "evaluate:corpus": "npm run build && node scripts/evaluate-corpus.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drizki/indonesian-badwords.git"
  },
  "author": "Dwi Rizki Irawan",
  "license": "MIT",
  "private": false,
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "semver": "7.8.5",
    "typescript": "7.0.2"
  }
}
