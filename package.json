{
  "name": "indonesian-badwords",
  "version": "2.2.1",
  "description": "Fast Indonesian profanity filter with TypeScript, Unicode-aware matching, and zero runtime dependencies",
  "keywords": [
    "indonesian",
    "bahasa-indonesia",
    "profanity",
    "profanity-filter",
    "badwords",
    "kata-kasar",
    "censorship",
    "text-moderation",
    "unicode",
    "typescript"
  ],
  "homepage": "https://github.com/drizki/indonesian-badwords#readme",
  "bugs": {
    "url": "https://github.com/drizki/indonesian-badwords/issues"
  },
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json",
    "./censor": {
      "import": {
        "types": "./dist/esm/censor.d.ts",
        "default": "./dist/esm/censor.js"
      },
      "require": {
        "types": "./dist/cjs/censor.d.ts",
        "default": "./dist/cjs/censor.js"
      }
    },
    "./evasion": {
      "import": {
        "types": "./dist/esm/evasion.d.ts",
        "default": "./dist/esm/evasion.js"
      },
      "require": {
        "types": "./dist/cjs/evasion.d.ts",
        "default": "./dist/cjs/evasion.js"
      }
    }
  },
  "files": [
    "dist/cjs/index.js",
    "dist/cjs/index.d.ts",
    "dist/cjs/censor.js",
    "dist/cjs/censor.d.ts",
    "dist/cjs/dictionary.d.ts",
    "dist/cjs/normalize.d.ts",
    "dist/cjs/package.json",
    "dist/esm",
    "dist/cjs/evasion.js",
    "dist/cjs/evasion.d.ts",
    "dist/cjs/evasion-types.d.ts",
    "dist/cjs/matcher.d.ts",
    "THIRD_PARTY_NOTICES"
  ],
  "sideEffects": false,
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc -p tsconfig.cjs.json && node scripts/postbuild.mjs",
    "test": "npm run build && npm run test:unit",
    "test:unit": "node --test",
    "test:package": "node scripts/verify-package.mjs",
    "benchmark": "npm run build && node scripts/benchmark.mjs",
    "benchmark:compare": "npm run build && node scripts/benchmark-compare.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drizki/indonesian-badwords.git"
  },
  "author": "Dwi Rizki Irawan",
  "license": "MIT",
  "private": false,
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "semver": "7.8.5",
    "typescript": "^7.0.2"
  }
}
